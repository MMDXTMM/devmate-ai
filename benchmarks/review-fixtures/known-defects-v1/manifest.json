      "scenarioKey": "concurrency-lost-update",
      "name": "库存并发丢失更新",
      "expectationType": "DEFECT",
      "rationale": "读取、判断和写回库存不是原子操作，并发请求可能基于同一旧值重复扣减。",
      "defects": [
        {
          "caseKey": "concurrency-lost-update",
          "category": "CONCURRENCY",
          "filePath": "src/main/java/benchmark/concurrency/InventoryService.java",
          "startLine": 11,
          "endLine": 16,
          "rationale": "目标代码把原子条件更新退化为先查后写，两个线程可同时通过库存判断。"
        }
      ]
    },
    {
      "scenarioKey": "transaction-self-invocation",
      "name": "事务方法同类自调用",
      "expectationType": "DEFECT",
