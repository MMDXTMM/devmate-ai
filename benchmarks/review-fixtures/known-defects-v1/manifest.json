          "startLine": 13,
          "endLine": 18,
          "rationale": "缓存未命中路径没有并发保护，每个请求都同步查询数据库。"
        }
      ]
    },
    {
      "scenarioKey": "message-ack-before-persist",
      "name": "消息先确认后落库",
      "expectationType": "DEFECT",
      "rationale": "消息确认早于业务落库，进程在两步之间失败会导致消息永久丢失。",
